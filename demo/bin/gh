#!/bin/sh
# Stands in for gh in the demo: logged in, no credential helper, a pull request at a made-up host, nothing else.
case "$1 $2" in
  "auth status") echo "Logged in to github.com account baker"; exit 0 ;;
  "auth git-credential") exit 1 ;;
  "pr create") echo "https://github.example/bakery/bakery/pull/12"; exit 0 ;;
  *) exit 2 ;;
esac
