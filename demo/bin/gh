#!/bin/sh
# Stands in for gh in the demo: a version, logged in, no credential helper, nothing else.
[ "$1" = "--version" ] && { echo "gh version 2.81.0 (demo)"; exit 0; }
case "$1 $2" in
  "auth status") echo "Logged in to github.com account baker"; exit 0 ;;
  "auth git-credential") exit 1 ;;
  *) exit 2 ;;
esac
