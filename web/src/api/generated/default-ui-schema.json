{
  "columns": [
    {
      "id": "stopped",
      "title": "Stopped",
      "statuses": [
        "stopped"
      ],
      "empty_hint": "Nothing stopped",
      "tone": "muted",
      "dim": true
    },
    {
      "id": "queued",
      "title": "Queued",
      "statuses": [
        "queued"
      ],
      "empty_hint": "Nothing waiting to start",
      "tone": "neutral",
      "dim": false
    },
    {
      "id": "working",
      "title": "Working",
      "statuses": [
        "working"
      ],
      "empty_hint": "No agent is working",
      "tone": "active",
      "dim": false
    },
    {
      "id": "needs_you",
      "title": "Needs you",
      "statuses": [
        "needs_you"
      ],
      "empty_hint": "No agent needs you",
      "tone": "attention",
      "dim": false
    },
    {
      "id": "review",
      "title": "Review",
      "statuses": [
        "review"
      ],
      "empty_hint": "Nothing to review",
      "tone": "done",
      "dim": false
    }
  ],
  "card_fields": [
    {
      "key": "repos",
      "label": "Repos",
      "kind": "badge",
      "show_when": {
        "type": "always"
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "title",
      "label": "Task",
      "kind": "text",
      "show_when": {
        "type": "always"
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "activity",
      "label": "Activity",
      "kind": "text",
      "show_when": {
        "type": "always"
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "branch",
      "label": "Branch",
      "kind": "mono",
      "show_when": {
        "type": "always"
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "status_since",
      "label": "In status",
      "kind": "duration",
      "show_when": {
        "type": "always"
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "blocked_reason",
      "label": "Blocked",
      "kind": "badge",
      "show_when": {
        "type": "status_in",
        "statuses": [
          "needs_you"
        ]
      },
      "value_labels": {
        "breakdown": "Breakdown to review",
        "error": "Error",
        "permission": "Permission needed",
        "question": "Question",
        "repo_access": "Repo access",
        "startup": "Startup prompt"
      },
      "value_tones": {}
    },
    {
      "key": "has_changes",
      "label": "Has changes",
      "kind": "badge",
      "show_when": {
        "type": "has_changes",
        "value": true
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "paused",
      "label": "Paused",
      "kind": "badge",
      "show_when": {
        "type": "paused",
        "value": true
      },
      "value_labels": {},
      "value_tones": {}
    },
    {
      "key": "stop_cause",
      "label": "Why it stopped",
      "kind": "badge",
      "show_when": {
        "type": "status_in",
        "statuses": [
          "stopped"
        ]
      },
      "value_labels": {
        "crashed": "Crashed",
        "exited": "Exited",
        "finished": "Finished",
        "interrupted": "Interrupted",
        "stopped": "Stopped"
      },
      "value_tones": {
        "crashed": "danger",
        "exited": "active",
        "finished": "active",
        "interrupted": "caution",
        "stopped": "caution"
      }
    },
    {
      "key": "disk_bytes",
      "label": "Size on disk",
      "kind": "bytes",
      "show_when": {
        "type": "status_in",
        "statuses": [
          "stopped"
        ]
      },
      "value_labels": {},
      "value_tones": {}
    }
  ],
  "actions": [
    {
      "id": "answer",
      "label": "Answer",
      "method": "POST",
      "path": "/api/agents/{id}/answer",
      "when": {
        "type": "all",
        "conditions": [
          {
            "type": "status_in",
            "statuses": [
              "needs_you"
            ]
          },
          {
            "type": "not",
            "condition": {
              "type": "blocked_reason_in",
              "reasons": [
                "repo_access"
              ]
            }
          }
        ]
      },
      "input": "text",
      "destructive": false
    },
    {
      "id": "pause",
      "label": "Pause",
      "method": "POST",
      "path": "/api/agents/{id}/pause",
      "when": {
        "type": "all",
        "conditions": [
          {
            "type": "paused",
            "value": false
          },
          {
            "type": "status_in",
            "statuses": [
              "working",
              "review"
            ]
          }
        ]
      },
      "input": null,
      "destructive": false
    },
    {
      "id": "resume",
      "label": "Resume",
      "method": "POST",
      "path": "/api/agents/{id}/resume",
      "when": {
        "type": "all",
        "conditions": [
          {
            "type": "paused",
            "value": true
          },
          {
            "type": "status_in",
            "statuses": [
              "queued",
              "working",
              "needs_you",
              "review"
            ]
          }
        ]
      },
      "input": null,
      "destructive": false
    },
    {
      "id": "stop",
      "label": "Stop",
      "method": "POST",
      "path": "/api/agents/{id}/stop",
      "when": {
        "type": "not",
        "condition": {
          "type": "status_in",
          "statuses": [
            "stopped"
          ]
        }
      },
      "input": null,
      "destructive": true
    }
  ],
  "forms": [
